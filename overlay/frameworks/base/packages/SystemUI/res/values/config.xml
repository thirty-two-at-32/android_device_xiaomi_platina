<!-- These resources are around just to allow their values to be customized
     for different hardware and product builds. -->
<resources>
    <!-- Should "4G" be shown instead of "LTE" when the network is NETWORK_TYPE_LTE? -->
    <bool name="config_show4GForLTE">true</bool>

    <!-- Fix for wake screen for notifications -->
    <integer-array name="config_doze_brightness_sensor_to_brightness">
        <item>-1</item>
        <item>5</item>
        <item>5</item>
        <item>27</item>
        <item>27</item>
    </integer-array>
    <integer-array name="config_doze_brightness_sensor_to_scrim_opacity">
        <item>-1</item>
        <item>133</item>
        <item>0</item>
        <item>0</item>
        <item>0</item>
    </integer-array>
    <bool name="doze_double_tap_reports_touch_coordinates">true</bool>
    <bool name="doze_pickup_performs_proximity_check">true</bool>
    <bool name="doze_selectively_register_prox">true</bool>
    <bool name="doze_suspend_display_state_supported">false</bool>
    <item type="dimen" name="proximity_sensor_secondary_threshold">1.0</item>
    <item type="dimen" name="proximity_sensor_threshold">12.0</item>
    <item type="dimen" name="proximity_sensor_threshold_latch">24.0</item>
    <string name="doze_brightness_sensor_type">com.google.sensor.binned_brightness</string>
    <string name="proximity_sensor_secondary_type">com.google.sensor.binned_brightness</string>
    <string name="proximity_sensor_type">android.sensor.light</string>
</resources>
